        return False


def promote_students_grade(from_grade, to_grade):
    """ترقية المرحلة الدراسية لجميع الطلاب من مرحلة إلى أخرى مع حفظ سجل للتراجع"""
    try:
        import json
        conn = get_db_connection()
        cursor = conn.cursor()
        
        # جلب IDs الطلاب المتأثرين أولاً
        cursor.execute(_q('SELECT id FROM students WHERE teacher_name = ?'), (from_grade,))
        affected_ids = [row['id'] for row in cursor.fetchall()]
        
        if not affected_ids:
            conn.close()
            return 0
        
        # إنشاء جدول السجل إذا ما موجود
        try:
            PK = 'SERIAL PRIMARY KEY' if IS_POSTGRES else 'INTEGER PRIMARY KEY AUTOINCREMENT'
            cursor.execute(f'''
                CREATE TABLE IF NOT EXISTS promotion_log (
                    id {PK},
                    from_grade TEXT NOT NULL,
                    to_grade TEXT NOT NULL,
                    student_ids TEXT NOT NULL,
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            ''')
            conn.commit()
        except Exception:
            pass
        
        # تنفيذ الترقية
        cursor.execute(_q('UPDATE students SET teacher_name = ? WHERE teacher_name = ?'), (to_grade, from_grade))
        count = cursor.rowcount
        
        # حفظ سجل التراجع
        cursor.execute(_q('INSERT INTO promotion_log (from_grade, to_grade, student_ids) VALUES (?,?,?)'),
                      (from_grade, to_grade, json.dumps(affected_ids)))
        
        conn.commit()
        conn.close()
        print(f'[DB] ✓ Promoted {count} students from {from_grade} to {to_grade}')
        return count
    except Exception as e:
        print(f'[DB Error] promote_students_grade: {e}')
        return 0


def get_last_promotion_log():
    """جلب آخر عملية ترقية لعكسها"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute(_q('''
            SELECT * FROM promotion_log 
            ORDER BY created_at DESC LIMIT 1
        '''))
        row = cursor.fetchone()
        conn.close()
        return dict(row) if row else None
    except Exception as e:
        print(f'[DB Error] get_last_promotion_log: {e}')
        return None


def undo_last_promotion():
    """التراجع عن آخر عملية ترقية"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        # جلب آخر عملية
        cursor.execute(_q('''
            SELECT * FROM promotion_log 
            ORDER BY created_at DESC LIMIT 1
        '''))
        log = cursor.fetchone()
        
        if not log:
            conn.close()
            return 0, 'لا توجد عملية ترقية سابقة'
        
        log = dict(log)
        from_grade = log['to_grade']   # عكس الاتجاه
        to_grade = log['from_grade']   # عكس الاتجاه
        student_ids = log['student_ids']  # الطلاب المتأثرين فقط
        
        import json
        ids_list = json.loads(student_ids)
        
        if not ids_list:
            conn.close()
            return 0, 'لا توجد بيانات للتراجع'
        
        # إرجاع الطلاب المتأثرين فقط
        count = 0
        for sid in ids_list:
            cursor.execute(_q('UPDATE students SET teacher_name = ? WHERE id = ? AND teacher_name = ?'),
                          (to_grade, sid, from_grade))
            if cursor.rowcount > 0:
                count += 1
        
        # حذف سجل الترقية
        cursor.execute(_q('DELETE FROM promotion_log WHERE id = ?'), (log['id'],))
        
        conn.commit()
        conn.close()
        return count, f'تم إرجاع {count} طالب من {from_grade} إلى {to_grade}'
    except Exception as e:
        print(f'[DB Error] undo_last_promotion: {e}')
        return 0, str(e)


# ═════════════════════════════════════════════════════════════════════
# Face Recognition Database Functions
# ═════════════════════════════════════════════════════════════════════

def init_face_recognition_tables():
    """تهيئة جداول Face Recognition"""
    conn = get_db_connection()
    cursor = conn.cursor()
    PK = 'SERIAL PRIMARY KEY' if IS_POSTGRES else 'INTEGER PRIMARY KEY AUTOINCREMENT'
    
    try:
        # إضافة حقول Face Recognition لجدول students
        if IS_POSTGRES:
            cursor.execute("ALTER TABLE students ADD COLUMN IF NOT EXISTS face_enrolled BOOLEAN DEFAULT FALSE")
            cursor.execute("ALTER TABLE students ADD COLUMN IF NOT EXISTS face_encoding TEXT")
            cursor.execute("ALTER TABLE students ADD COLUMN IF NOT EXISTS face_image_path TEXT")
            cursor.execute("ALTER TABLE students ADD COLUMN IF NOT EXISTS face_enrolled_at TIMESTAMP")
            cursor.execute("ALTER TABLE students ADD COLUMN IF NOT EXISTS face_updated_at TIMESTAMP")
            cursor.execute("ALTER TABLE students ADD COLUMN IF NOT EXISTS face_image_data TEXT")
        else:
            # SQLite - نضيفها إذا ما كانت موجودة
            cursor.execute('PRAGMA table_info(students)')
            columns = {row['name'] for row in cursor.fetchall()}
            if 'face_enrolled' not in columns:
                cursor.execute('ALTER TABLE students ADD COLUMN face_enrolled INTEGER DEFAULT 0')
            if 'face_encoding' not in columns:
                cursor.execute('ALTER TABLE students ADD COLUMN face_encoding TEXT')
            if 'face_image_path' not in columns:
                cursor.execute('ALTER TABLE students ADD COLUMN face_image_path TEXT')
            if 'face_enrolled_at' not in columns:
                cursor.execute('ALTER TABLE students ADD COLUMN face_enrolled_at TIMESTAMP')
            if 'face_updated_at' not in columns:
                cursor.execute('ALTER TABLE students ADD COLUMN face_updated_at TIMESTAMP')
            if 'face_image_data' not in columns:
                cursor.execute('ALTER TABLE students ADD COLUMN face_image_data TEXT')
        
        # إضافة حقل method لجدول attendance
        if IS_POSTGRES:
            cursor.execute("ALTER TABLE attendance ADD COLUMN IF NOT EXISTS method TEXT DEFAULT 'QR'")
            cursor.execute("ALTER TABLE attendance ADD COLUMN IF NOT EXISTS confidence REAL")
        else:
            cursor.execute('PRAGMA table_info(attendance)')
            columns = {row['name'] for row in cursor.fetchall()}
            if 'method' not in columns:
                cursor.execute("ALTER TABLE attendance ADD COLUMN method TEXT DEFAULT 'QR'")
            if 'confidence' not in columns:
                cursor.execute("ALTER TABLE attendance ADD COLUMN confidence REAL")
        
        # جدول Face Recognition Logs
        cursor.execute(f'''
            CREATE TABLE IF NOT EXISTS face_recognition_logs (
                id {PK},
                student_id INTEGER,
                session_id INTEGER,
                result TEXT NOT NULL,
                confidence REAL,
                timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                reason TEXT,
                image_path TEXT
            )
        ''')
        
        # جدول Face Attendance Sessions
        cursor.execute(f'''
            CREATE TABLE IF NOT EXISTS face_attendance_sessions (
                id {PK},
                subject_id INTEGER NOT NULL,
                created_by INTEGER NOT NULL,
                start_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                end_time TIMESTAMP,
                status TEXT DEFAULT 'ACTIVE',
                recognition_threshold REAL DEFAULT 0.6,
                session_name TEXT
            )
        ''')
        
        conn.commit()
        print('[DB] ✅ Face Recognition tables initialized')
    except Exception as e:
        print(f'[DB Error] init_face_recognition_tables: {e}')
        conn.rollback()
    finally:
        conn.close()


def update_student_face_encoding(student_id, face_encoding, face_image_path=None, face_image_data=None):
    """
    تحديث/تسجيل Face Encoding للطالب
    face_image_data: base64 string للصورة (تُخزَّن في DB لتبقى على Railway)
    """
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        import json
        encoding_json = json.dumps(face_encoding)
        now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')

        if IS_POSTGRES:
            if face_image_path:
                cursor.execute('''
                    UPDATE students 
                    SET face_enrolled = TRUE, 
                        face_encoding = %s, 
                        face_image_path = %s,
                        face_image_data = %s,
                        face_enrolled_at = COALESCE(face_enrolled_at, %s),
                        face_updated_at = %s
                    WHERE id = %s
                ''', (encoding_json, face_image_path, face_image_data, now, now, student_id))
            else:
                cursor.execute('''
                    UPDATE students 
                    SET face_enrolled = TRUE, 
                        face_encoding = %s,
                        face_image_data = %s,
                        face_enrolled_at = COALESCE(face_enrolled_at, %s),
                        face_updated_at = %s
                    WHERE id = %s
                ''', (encoding_json, face_image_data, now, now, student_id))
        else:
            if face_image_path:
                cursor.execute('''
                    UPDATE students 
                    SET face_enrolled = 1, 
                        face_encoding = ?, 
                        face_image_path = ?,
                        face_image_data = ?,
                        face_enrolled_at = COALESCE(face_enrolled_at, ?),
                        face_updated_at = ?
                    WHERE id = ?
                ''', (encoding_json, face_image_path, face_image_data, now, now, student_id))
            else:
                cursor.execute('''
                    UPDATE students 
                    SET face_enrolled = 1, 
                        face_encoding = ?,
                        face_image_data = ?,
                        face_enrolled_at = COALESCE(face_enrolled_at, ?),
                        face_updated_at = ?
                    WHERE id = ?
                ''', (encoding_json, face_image_data, now, now, student_id))

        conn.commit()
        affected = cursor.rowcount
        conn.close()
        return affected > 0
    except Exception as e:
        print(f'[DB Error] update_student_face_encoding: {e}')
        return False


def get_student_face_encoding(student_id):
    """
    جلب Face Encoding للطالب
    Returns: list (128-d) or None
    """
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute(_q('SELECT face_encoding FROM students WHERE id = ?'), (student_id,))
        result = cursor.fetchone()
        conn.close()
        
        if result and result['face_encoding']:
            import json
            return json.loads(result['face_encoding'])
        return None
    except Exception as e:
        print(f'[DB Error] get_student_face_encoding: {e}')
        return None


def get_all_enrolled_faces():
    """
    جلب جميع الوجوه المسجلة
    Returns: list of {'student_id': int, 'name': str, 'face_encoding': list}
    """
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        if IS_POSTGRES:
            cursor.execute('''
                SELECT id, full_name, face_encoding 
                FROM students 
                WHERE face_enrolled = TRUE AND face_encoding IS NOT NULL
            ''')
        else:
            cursor.execute('''
                SELECT id, full_name, face_encoding 
                FROM students 
                WHERE face_enrolled = 1 AND face_encoding IS NOT NULL
            ''')
        
        rows = cursor.fetchall()
        conn.close()
        
        import json
        result = []
        for row in rows:
            try:
                # face_encoding هو base64 string مباشرة، ليس JSON
                encoding = row['face_encoding']
                if encoding and isinstance(encoding, str):
                    result.append({
                        'student_id': row['id'],
                        'name': row['full_name'], 
                        'face_encoding': encoding
                    })
            except Exception as e:
                print(f'[DB] خطأ في encoding للطالب {row["id"]}: {e}')
                continue
        
        return result
    except Exception as e:
        print(f'[DB Error] get_all_enrolled_faces: {e}')
        return []


def delete_student_face_data(student_id):
    """حذف بيانات الوجه للطالب"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        if IS_POSTGRES:
            cursor.execute('''
                UPDATE students 
                SET face_enrolled = FALSE,
                    face_encoding = NULL,
                    face_image_path = NULL,
                    face_updated_at = %s
                WHERE id = %s
            ''', (datetime.now().strftime('%Y-%m-%d %H:%M:%S'), student_id))
        else:
            cursor.execute('''
                UPDATE students 
                SET face_enrolled = 0,
                    face_encoding = NULL,
                    face_image_path = NULL,
                    face_updated_at = ?
                WHERE id = ?
            ''', (datetime.now().strftime('%Y-%m-%d %H:%M:%S'), student_id))
        
        conn.commit()
        affected = cursor.rowcount
        conn.close()
        return affected > 0
    except Exception as e:
        print(f'[DB Error] delete_student_face_data: {e}')
        return False


def log_face_recognition_attempt(student_id, session_id, result, confidence, reason=None, image_path=None):
    """
    تسجيل محاولة التعرف على الوجه
    
    Args:
        student_id: معرف الطالب (None للوجوه غير المعروفة)
        session_id: معرف جلسة الحضور
        result: نتيجة المحاولة (SUCCESS, UNKNOWN, LOW_CONFIDENCE, إلخ)
        confidence: درجة الثقة (0-1)
        reason: سبب الفشل (اختياري)
        image_path: مسار الصورة (اختياري - للتحليل)
    """
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        cursor.execute(_q('''
            INSERT INTO face_recognition_logs 
                (student_id, session_id, result, confidence, reason, image_path)
            VALUES (?, ?, ?, ?, ?, ?)
        '''), (student_id, session_id, result, confidence, reason, image_path))
        
        conn.commit()
        conn.close()
        return True
    except Exception as e:
        print(f'[DB Error] log_face_recognition_attempt: {e}')
        return False


def create_face_attendance_session(subject_id, created_by, threshold=0.6, session_name=None):
    """
    إنشاء جلسة حضور بالوجه
    
    Args:
        subject_id: معرف المادة
        created_by: معرف المستخدم (المدرس)
        threshold: عتبة التعرف
        session_name: اسم الجلسة (اختياري)
    
    Returns: session_id or None
    """
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        cursor.execute(_q('''
            INSERT INTO face_attendance_sessions 
                (subject_id, created_by, recognition_threshold, session_name, status)
            VALUES (?, ?, ?, ?, 'ACTIVE')
        '''), (subject_id, created_by, threshold, session_name))
        
        conn.commit()
        
        if IS_POSTGRES:
            cursor.execute('SELECT lastval()')
            session_id = cursor.fetchone()[0]
        else:
            session_id = cursor.lastrowid
        
        conn.close()
        return session_id
    except Exception as e:
        print(f'[DB Error] create_face_attendance_session: {e}')
        return None


def close_face_attendance_session(session_id):
    """إغلاق جلسة حضور بالوجه"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        now = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        cursor.execute(_q('''
            UPDATE face_attendance_sessions 
            SET status = 'CLOSED', end_time = ?
            WHERE id = ?
        '''), (now, session_id))
        
        conn.commit()
        affected = cursor.rowcount
        conn.close()
        return affected > 0
    except Exception as e:
        print(f'[DB Error] close_face_attendance_session: {e}')
        return False


