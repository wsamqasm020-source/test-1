def record_face_attendance(student_id, subject_id, group_name, confidence, session_id=None, method='FACE'):
    """
    تسجيل حضور بالوجه
    
    Args:
        student_id: معرف الطالب
        subject_id: معرف المادة
        group_name: اسم المجموعة
        confidence: درجة الثقة
        session_id: معرف جلسة الحضور (اختياري)
        method: طريقة الحضور (FACE)
    
    Returns: bool (True إذا تم التسجيل، False إذا مسجل مسبقاً)
    """
    conn = None
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        if IS_POSTGRES:
            cursor.execute('SELECT id FROM students WHERE id = %s FOR UPDATE', (student_id,))
        else:
            cursor.execute('BEGIN IMMEDIATE')
            cursor.execute('SELECT id FROM students WHERE id = ?', (student_id,))
        if not cursor.fetchone():
            conn.rollback()
            return False

        cursor.execute(_q('SELECT id FROM subjects WHERE id = ?'), (subject_id,))
        if not cursor.fetchone():
            conn.rollback()
            return False

        if session_id is not None:
            cursor.execute(_q('''
                SELECT 1 FROM face_attendance_sessions
                WHERE id = ? AND subject_id = ? AND status = 'ACTIVE'
            '''), (session_id, subject_id))
            if not cursor.fetchone():
                conn.rollback()
                return False

        today = datetime.now().date().isoformat()
        now_time = datetime.now().time().replace(microsecond=0).isoformat()

        cursor.execute(_q('''
            SELECT 1 FROM attendance
            WHERE student_id = ? AND subject_id = ? AND attendance_date = ?
        '''), (student_id, subject_id, today))
        
        if cursor.fetchone():
            conn.rollback()
            return False

        cursor.execute(_q('''
            INSERT INTO attendance
                (student_id, subject_id, group_name, attendance_date, attendance_time, method, confidence)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        '''), (student_id, subject_id, group_name, today, now_time, method, confidence))

        conn.commit()
        if session_id:
            log_face_recognition_attempt(student_id, session_id, 'SUCCESS', confidence)
        return True
    except Exception as e:
        print(f'[DB Error] record_face_attendance: {e}')
        return False
    finally:
        if conn:
            conn.close()


def get_face_recognition_logs(session_id=None, limit=100):
    """جلب سجلات التعرف على الوجه"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        if session_id:
            cursor.execute(_q('''
                SELECT l.*, s.full_name as student_name, s.student_code
                FROM face_recognition_logs l
                LEFT JOIN students s ON l.student_id = s.id
                WHERE l.session_id = ?
                ORDER BY l.timestamp DESC
                LIMIT ?
            '''), (session_id, limit))
        else:
            cursor.execute(_q('''
                SELECT l.*, s.full_name as student_name, s.student_code
                FROM face_recognition_logs l
                LEFT JOIN students s ON l.student_id = s.id
                ORDER BY l.timestamp DESC
                LIMIT ?
            '''), (limit,))
        
        rows = cursor.fetchall()
        conn.close()
        return [dict(r) for r in rows]
    except Exception as e:
        print(f'[DB Error] get_face_recognition_logs: {e}')
        return []


def get_face_attendance_stats(session_id=None, date=None):
    """
    إحصائيات حضور الوجه
    
    Returns: {
        'total_attempts': int,
        'successful': int,
        'failed': int,
        'unknown_faces': int,
        'low_confidence': int,
        'duplicate_attempts': int
    }
    """
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        if session_id:
            cursor.execute(_q('''
                SELECT result, COUNT(*) as count
                FROM face_recognition_logs
                WHERE session_id = ?
                GROUP BY result
            '''), (session_id,))
        elif date:
            cursor.execute(_q('''
                SELECT result, COUNT(*) as count
                FROM face_recognition_logs
                WHERE DATE(timestamp) = ?
                GROUP BY result
            '''), (date,))
        else:
            today = datetime.now().date().isoformat()
            cursor.execute(_q('''
                SELECT result, COUNT(*) as count
                FROM face_recognition_logs
                WHERE DATE(timestamp) = ?
                GROUP BY result
            '''), (today,))
        
        rows = cursor.fetchall()
        conn.close()
        
        stats = {
            'total_attempts': 0,
            'successful': 0,
            'failed': 0,
            'unknown_faces': 0,
            'low_confidence': 0,
            'duplicate_attempts': 0,
            'poor_quality': 0,
            'multiple_faces': 0,
            'no_face': 0
        }
        
        for row in rows:
            result = row['result']
            count = row['count']
            stats['total_attempts'] += count
            
            if result == 'SUCCESS':
                stats['successful'] += count
            elif result == 'UNKNOWN':
                stats['unknown_faces'] += count
            elif result == 'LOW_CONFIDENCE':
                stats['low_confidence'] += count
            elif result == 'DUPLICATE':
                stats['duplicate_attempts'] += count
            elif result == 'POOR_QUALITY':
                stats['poor_quality'] += count
            elif result == 'MULTIPLE_FACES':
                stats['multiple_faces'] += count
            elif result == 'NO_FACE':
                stats['no_face'] += count
            else:
                stats['failed'] += count
        
        return stats
    except Exception as e:
        print(f'[DB Error] get_face_attendance_stats: {e}')
        return {}


def get_students_without_face_enrollment():
    """جلب الطلاب الذين لم يسجلوا وجوههم"""
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        
        if IS_POSTGRES:
            cursor.execute('''
                SELECT * FROM students 
                WHERE face_enrolled = FALSE OR face_enrolled IS NULL OR face_encoding IS NULL
                ORDER BY full_name ASC
            ''')
        else:
            cursor.execute('''
                SELECT * FROM students 
                WHERE face_enrolled = 0 OR face_enrolled IS NULL OR face_encoding IS NULL
                ORDER BY full_name ASC
            ''')
        
        rows = cursor.fetchall()
        conn.close()
        return [dict(r) for r in rows]
    except Exception as e:
        print(f'[DB Error] get_students_without_face_enrollment: {e}')
        return []


def get_face_recognition_settings():
    """جلب إعدادات Face Recognition من جدول settings"""
    settings = get_settings()
    return {
        'recognition_threshold': settings.get('face_recognition_threshold', 0.68),  # Facenet512 cosine similarity
        'min_face_size': settings.get('face_min_size', 80),
        'save_recognition_logs': settings.get('face_save_logs', True),
        'enable_liveness_detection': settings.get('face_liveness_detection', False),
        'cooldown_seconds': settings.get('face_cooldown_seconds', 3)
    }


def save_face_recognition_settings(threshold=None, min_face_size=None, save_logs=None, liveness=None, cooldown=None):
    """حفظ إعدادات Face Recognition"""
    settings = get_settings()
    
    if threshold is not None:
        settings['face_recognition_threshold'] = float(threshold)
    if min_face_size is not None:
        settings['face_min_size'] = int(min_face_size)
    if save_logs is not None:
        settings['face_save_logs'] = bool(save_logs)
    if liveness is not None:
        settings['face_liveness_detection'] = bool(liveness)
    if cooldown is not None:
        settings['face_cooldown_seconds'] = int(cooldown)
    
    save_settings(settings)
    return True
