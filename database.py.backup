def verify_student_password(student_id, password):
    conn = None
    try:
        conn = get_db_connection()
        cursor = conn.cursor()
        cursor.execute(_q('SELECT password FROM students WHERE id = ?'), (student_id,))
        row = cursor.fetchone()
        if not row or not _password_matches(row['password'], password):
            return False

        if not row['password'].startswith(('pbkdf2:', 'scrypt:')):
            cursor.execute(
                _q('UPDATE students SET password = ? WHERE id = ?'),
                (_hash_password(password), student_id)
            )
            conn.commit()
        return True
    except Exception as e:
        print(f'[DB Error] verify_student_password: {e}')
        return False
    finally:
        if conn:
            conn.close()


